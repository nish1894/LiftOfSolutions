{
  "default_provider": "openai",
  "providers": {
    "openai": {
      "provider": "openai",
      "aliases": ["openai", "oai"],
      "default_model": "gpt-4.1-mini",
      "env": ["OPENAI_API_KEY"]
    },
    "gemini": {
      "provider": "google_genai",
      "aliases": ["gemini", "google", "genai"],
      "default_model": "gemini-2.5-flash",
      "env": ["GOOGLE_API_KEY"]
    },
    "deepseek": {
      "provider": "deepseek",
      "aliases": ["deepseek", "ds"],
      "default_model": "deepseek-chat",
      "env": ["DEEPSEEK_API_KEY"]
    }
  },
  "models": {
    "openai:fast": {
      "provider": "openai",
      "model": "gpt-4.1-mini"
    },
    "openai:smart": {
      "provider": "openai",
      "model": "gpt-4.1"
    },
    "gemini:flash": {
      "provider": "google_genai",
      "model": "gemini-2.5-flash"
    },
    "gemini:pro": {
      "provider": "google_genai",
      "model": "gemini-2.5-pro"
    },
    "deepseek:chat": {
      "provider": "deepseek",
      "model": "deepseek-chat"
    },
    "deepseek:reasoner": {
      "provider": "deepseek",
      "model": "deepseek-reasoner"
    }
  }
}
