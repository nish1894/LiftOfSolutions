# Application
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Firebase Admin. Use Application Default Credentials locally, a service
# account JSON/base64 value in production, or the emulator variables below.
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_APP_NAME=erp-chatbot-platform
FIREBASE_SERVICE_ACCOUNT_JSON=
# true = ask Firebase on every request whether the token was revoked (required in production;
# costs one extra Firebase call per request).
FIREBASE_CHECK_REVOKED_TOKENS=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Node platform to the RAG service (../LiftOfMain; the gateway is rewritten for its new API).
AI_SERVICE_MODE=rag
AI_SERVICE_URL=http://localhost:8010
AI_SERVICE_SERVER_ID=chatbot-platform
AI_SERVICE_API_KEY=replace-with-a-long-shared-rag-secret
AI_SERVICE_DOCUMENT_BASE_URL=http://localhost:8081

# Object storage (set STORAGE_BACKEND=s3 outside local development)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google and GitHub providers are enabled in Firebase Authentication console.
# Their provider secrets never go in VITE_* browser variables.

# Terms of service shown at first sign-in. TERMS_URL is required in production.
TERMS_VERSION=development-preview
TERMS_URL=
